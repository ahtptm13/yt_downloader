{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grabber",
  "version": "0.1.1",
  "identifier": "app.grabber.ytdlp",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grabber",
        "width": 980,
        "height": 860,
        "minWidth": 720,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0E0F12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0ODAzQUU5MEQxMzA4MkIKUldRckNCTU42VHFBTkczbTBPRnJIV3JHYU83M2h4RENtL1NIeGdtdDh1T29JeFUxT2kxRzFnNlIK",
      "endpoints": [
        "https://github.com/ahtptm13/yt_downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
